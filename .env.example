# Optional advanced overrides only. The default Compose and first-run wizard do
# not require an .env file. Never commit a real file containing private values.
SONGLIB_IMAGE=666uos/songlib-amp:latest
CONTAINER_NAME=songlib-amp
APP_PORT=32782
TZ=Asia/Shanghai
PUID=1000
PGID=1000

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://nas-address:32782
# Optional comma-separated hostnames. Leave empty for LAN installations using changing hostnames.
TRUSTED_HOSTS=
FORWARDED_ALLOW_IPS=127.0.0.1

SONGLIB_DATA_DIR=./data
SONGLIB_DOWNLOADS_DIR=./downloads
MUSIC_DIR=./music
# Optional. Uncomment the matching volume in docker-compose.yml when used.
PLEX_CONFIG_DIR=./plex-config

# Plex is optional and can also be configured in the installation UI.
PLEX_URL=
PLEX_SECTION=
PLEX_MEDIA_PREFIX=

# Optional fnOS Music playlist connector. Create a dedicated service token;
# never copy a browser cookie into source control.
FNOS_MUSIC_URL=
FNOS_MUSIC_TOKEN=

# DOWNLOAD_ROOT is a separate Compose mount. DOWNLOAD_DIR is a subfolder
# inside that mount; downloaded files never stage under MUSIC_ROOT.
DOWNLOAD_DIR=authorized
MAX_DOWNLOAD_MB=500
SOURCE_MAX_SIZE_MB=2
SOURCE_TIMEOUT_SECONDS=55
ALLOW_PRIVATE_DOWNLOAD_URLS=false
ALLOW_PROXY_FAKE_IPS=false
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=180
WORKER_MAX_ATTEMPTS=3
