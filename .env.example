# Optional advanced overrides only. The default Compose and first-run wizard do
# not require an .env file. Never commit a real file containing private values.
SONGLIB_IMAGE=666uos/songlib-amp:latest
CONTAINER_NAME=songlib-amp
APP_PORT=32782
TZ=Asia/Shanghai
PUID=1000
PGID=1000
# Optional Intel QSV supplementary group IDs used after enabling the commented
# devices/group_add block in docker-compose.yml.
RENDER_GID=109
VIDEO_GID=44

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://nas-address:32782
# Optional comma-separated hostnames. Leave empty for LAN installations using changing hostnames.
TRUSTED_HOSTS=
FORWARDED_ALLOW_IPS=127.0.0.1

SONGLIB_DATA_DIR=./data
SONGLIB_DOWNLOADS_DIR=./downloads
MUSIC_DIR=./music
# Optional. Uncomment the matching volume in docker-compose.yml when used.
PLEX_CONFIG_DIR=./plex-config

# Plex is optional and can also be configured in the installation UI.
PLEX_URL=
PLEX_SECTION=
PLEX_MEDIA_PREFIX=

# Optional fnOS Music playlist connector. Create a dedicated service token;
# never copy a browser cookie into source control.
FNOS_MUSIC_URL=
FNOS_MUSIC_TOKEN=

# DOWNLOAD_ROOT is a separate Compose mount. DOWNLOAD_DIR is a subfolder
# inside that mount; downloaded files never stage under MUSIC_ROOT.
DOWNLOAD_DIR=authorized
MAX_DOWNLOAD_MB=500
SOURCE_MAX_SIZE_MB=2
SOURCE_TIMEOUT_SECONDS=55
ALLOW_PRIVATE_DOWNLOAD_URLS=false
ALLOW_PROXY_FAKE_IPS=false
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=180
WORKER_MAX_ATTEMPTS=3

# Native AirPlay lyrics video. AIRPLAY_PUBLIC_BASE_URL must be the HTTPS origin
# that both Safari and Apple TV can reach; leave empty to use the request origin.
AIRPLAY_CAST_ENABLED=true
AIRPLAY_PUBLIC_BASE_URL=
AIRPLAY_ENCODER=auto
AIRPLAY_WIDTH=1920
AIRPLAY_HEIGHT=1080
AIRPLAY_FPS=30
AIRPLAY_RENDER_FPS=4
AIRPLAY_SEGMENT_SECONDS=1.0
# Optional, e.g. 3M for 1080p or 12M for 4K. Empty selects that default.
AIRPLAY_VIDEO_BITRATE=
AIRPLAY_LYRIC_ADVANCE_MS=250
AIRPLAY_PIPELINE_ADVANCE_MS=1750
AIRPLAY_DRIFT_GAIN=0.35
AIRPLAY_DRIFT_STEP_MS=250
AIRPLAY_HARD_SYNC_MS=2000
AIRPLAY_SESSION_TTL_SECONDS=14400
AIRPLAY_STREAM_IDLE_SECONDS=90
AIRPLAY_FONT_PATH=
FFMPEG_BINARY=ffmpeg
