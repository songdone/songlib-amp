# Copy to .env on the NAS. Never commit the real .env file.
COMPOSE_PROJECT_NAME=songlib-amp
SONGLIB_IMAGE=songlib-amp:1.0.0-rc.2
APP_PORT=32782
APP_BIND_ADDRESS=0.0.0.0
APP_UID=10001
APP_GID=10001
TZ=Asia/Shanghai

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://nas-address:32782
# Optional comma-separated hostnames. Leave empty for LAN installations using changing hostnames.
TRUSTED_HOSTS=
FORWARDED_ALLOW_IPS=127.0.0.1

SONGLIB_DATA_DIR=./volumes/data
SONGLIB_DOWNLOADS_DIR=./volumes/downloads
MUSIC_DIR=./volumes/music
# Optional existing library mounted read-only under /music/library.
READ_ONLY_LIBRARY_DIR=./volumes/library
PLEX_CONFIG_DIR=./volumes/plex-config

# Plex is optional and can also be configured in the installation UI.
PLEX_URL=
PLEX_SECTION=
PLEX_MEDIA_PREFIX=

# Optional fnOS Music playlist connector. Create a dedicated service token;
# never copy a browser cookie into source control.
FNOS_MUSIC_URL=
FNOS_MUSIC_TOKEN=

# DOWNLOAD_ROOT is a separate Compose mount. DOWNLOAD_DIR is a subfolder
# inside that mount; downloaded files never stage under MUSIC_ROOT.
DOWNLOAD_DIR=authorized
MAX_DOWNLOAD_MB=500
SOURCE_MAX_SIZE_MB=2
SOURCE_TIMEOUT_SECONDS=55
ALLOW_PRIVATE_DOWNLOAD_URLS=false
ALLOW_PROXY_FAKE_IPS=false
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=180
WORKER_MAX_ATTEMPTS=3
