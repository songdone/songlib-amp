<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 内置苹方。
	     tvOS 的运行时里没有 PingFang（查过 tvOS 26.5 的模拟器运行时，
	     一个都没有），所以中文默认落到系统的兜底字体上 —— 那是这个应用
	     "中文看着廉价"的根本原因，每一个汉字都在受影响。
	     Forward 也是这么做的（它打包了 36MB 的 PingFang SC/HK/TC）。 -->
	<key>UIAppFonts</key>
	<array>
		<string>PingFangSC-Light.ttf</string>
		<string>PingFangSC-Medium.ttf</string>
		<string>PingFangSC-Bold.ttf</string>
		<string>PingFangSC-Heavy.ttf</string>
	</array>
</dict>
</plist>
